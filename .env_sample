# ----------------------------------
# Server Configuration
# ----------------------------------
# The port the Go application will listen on
PORT=7979

# Set to "True" for production, "False" for development
# In dev mode, /dev routes are enabled and auth may be bypassed (see main.go)
ENV_IS_PROD=False

# ----------------------------------
# Database (PostgreSQL)
# ----------------------------------
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=geo_tree_table
DB_USER=geo_tree_table
DB_PASSWORD=changeme_db_password
DB_SSL_MODE=prefer

# ----------------------------------
# JWT (Authentication)
# ----------------------------------
# A strong, random secret string for signing JWTs (e.g., 32+ chars)
JWT_SECRET="changeme_super_secret_jwt_key_32_chars+"

# An ID for your application (can be a UUID)
JWT_ISSUER_ID="changeme_your_app_issuer_id"

# The key used to store JWT claims in the Echo context
JWT_CONTEXT_KEY=gojwtdata

# How long a JWT is valid for (in minutes)
JWT_DURATION_MINUTES=60

# The API path for the login endpoint
JWT_AUTH_URL=/goLogin

# The API path for the JWT status/check endpoint
JWT_STATUS_URL=/goStatus

# ----------------------------------
# Default Admin User
# ----------------------------------
# This is used by the SimpleAdminAuthenticator
ADMIN_USER=goadmin
ADMIN_EMAIL=goadmin@yourdomain.com
ADMIN_ID=999999
ADMIN_EXTERNAL_ID=111111
ADMIN_PASSWORD=changeme_admin_password

# ----------------------------------
# Security / CORS
# ----------------------------------
# Hosts allowed to connect (used for CORS)
ALLOWED_HOSTS="localhost"